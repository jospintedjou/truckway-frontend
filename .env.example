# Leave empty to call the API on the same origin (/api). nginx proxies it to the backend.
# Set it only if the API lives on another domain, e.g. https://api.truckway.example.com
VITE_API_URL=

# Production container: host port, and where nginx forwards /api
WEB_PORT=8020
API_UPSTREAM=http://host.docker.internal:8021

# Development: where the Vite dev server forwards /api
DEV_API_PROXY=http://localhost:8000
DEV_API_PROXY_DOCKER=http://host.docker.internal:8000
